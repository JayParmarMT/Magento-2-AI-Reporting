<script>
require(['jquery', 'chartjs'], function($, Chart) {
    'use strict';

    const REFRESH_URL = '<?= $block->escapeJs($block->getRefreshDataUrl()) ?>';
    const EXPORT_URL = '<?= $block->escapeJs($block->getExportUrl()) ?>';
    const FORM_KEY = '<?= $block->escapeJs($block->getFormKey()) ?>';
    const CURRENCY = '<?= $block->escapeJs($block->getCurrencySymbol()) ?>';

    let dashboardCharts = {};
    let currentData = <?= /* @noEscape */ json_encode($dashboardData, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

    initializeCharts(currentData);

    $('#ai-date-range').on('change', function() {
        const range = $(this).val();
        if (range === 'custom') {
            $('#ai-custom-date-range').show();
        } else {
            $('#ai-custom-date-range').hide();
            refreshDashboard(range);
        }
    });

    $('#ai-apply-custom-range').on('click', function() {
        const start = $('#ai-start-date').val();
        const end = $('#ai-end-date').val();
        if (start && end) {
            refreshDashboard('custom', start, end);
        } else {
            alert('<?= $block->escapeJs(__('Please select both start and end dates')) ?>');
        }
    });

    $('#ai-export-btn').on('click', function() {
        const range = $('#ai-date-range').val();
        const start = $('#ai-start-date').val();
        const end = $('#ai-end-date').val();
        
        let url = EXPORT_URL + '?format=csv&date_range=' + range + '&form_key=' + FORM_KEY;
        if (range === 'custom' && start && end) {
            url += '&custom_start=' + start + '&custom_end=' + end;
        }
        
        window.location.href = url;
    });

    function refreshDashboard(dateRange, customStart, customEnd) {
        $('#ai-dashboard-loading').show();
        
        $.ajax({
            url: REFRESH_URL,
            type: 'POST',
            data: {
                date_range: dateRange,
                custom_start: customStart,
                custom_end: customEnd,
                form_key: FORM_KEY
            },
            dataType: 'json',
            success: function(response) {
                $('#ai-dashboard-loading').hide();
                if (response.success) {
                    currentData = response.data;
                    updateDashboard(response.data);
                } else {
                    alert('<?= $block->escapeJs(__('Failed to refresh dashboard')) ?>');
                }
            },
            error: function() {
                $('#ai-dashboard-loading').hide();
                alert('<?= $block->escapeJs(__('Request failed')) ?>');
            }
        });
    }

    function updateDashboard(data) {
        updateKpis(data.kpis);
        updateCharts(data);
        updateTopProductsTable(data.top_products);
    }

    function updateKpis(kpis) {
        $('#kpi-revenue').text(CURRENCY + formatNumber(kpis.total_revenue, 2));
        updateTrend('#kpi-revenue-trend', kpis.total_revenue_change);
        
        $('#kpi-orders').text(formatNumber(kpis.total_orders));
        updateTrend('#kpi-orders-trend', kpis.total_orders_change);
        
        $('#kpi-customers').text(formatNumber(kpis.active_customers));
        updateTrend('#kpi-customers-trend', kpis.active_customers_change);
        
        $('#kpi-aov').text(CURRENCY + formatNumber(kpis.avg_order_value, 2));
        updateTrend('#kpi-aov-trend', kpis.avg_order_value_change);
        
        $('#kpi-products-sold').text(formatNumber(kpis.products_sold));
        $('#kpi-low-stock').text(formatNumber(kpis.low_stock));
        $('#kpi-out-of-stock').text(formatNumber(kpis.out_of_stock));
    }

    function updateTrend(selector, change) {
        const $trend = $(selector);
        const isPositive = change >= 0;
        
        $trend.removeClass('ai-trend-up ai-trend-down')
              .addClass(isPositive ? 'ai-trend-up' : 'ai-trend-down');
        
        $trend.find('.ai-trend-icon').text(isPositive ? '↑' : '↓');
        $trend.find('.ai-trend-value').text(Math.abs(change) + '%');
    }

    function formatNumber(num, decimals = 0) {
        return parseFloat(num).toLocaleString(undefined, {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
        });
    }

    function initializeCharts(data) {
        dashboardCharts.revenueTrend = createRevenueTrendChart(data.revenue_trend);
        dashboardCharts.ordersStatus = createOrdersStatusChart(data.orders_by_status);
        dashboardCharts.customerSegments = createCustomerSegmentsChart(data.customer_segments);
        dashboardCharts.revenueDow = createRevenueDowChart(data.revenue_by_dow);
        dashboardCharts.stockDist = createStockDistChart(data.stock_distribution);
        dashboardCharts.revenueCategory = createRevenueCategoryChart(data.revenue_by_category);
    }

    function updateCharts(data) {
        Object.values(dashboardCharts).forEach(chart => {
            if (chart) chart.destroy();
        });
        initializeCharts(data);
    }

    function createRevenueTrendChart(data) {
        return new Chart(document.getElementById('chart-revenue-trend'), {
            type: 'line',
            data: {
                labels: data.map(r => r.label),
                datasets: [
                    {
                        label: '<?= $block->escapeJs(__('Revenue (%1)', $block->getCurrencySymbol())) ?>',
                        data: data.map(r => parseFloat(r.revenue)),
                        borderColor: '#f25c05',
                        backgroundColor: 'rgba(242,92,5,0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        yAxisID: 'y'
                    },
                    {
                        label: '<?= $block->escapeJs(__('Orders')) ?>',
                        data: data.map(r => parseInt(r.orders)),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16,185,129,0.1)',
                        borderWidth: 2,
                        fill: false,
                        tension: 0.4,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                scales: {
                    y: { type: 'linear', position: 'left', title: { display: true, text: '<?= $block->escapeJs(__('Revenue (%1)', $block->getCurrencySymbol())) ?>' } },
                    y1: { type: 'linear', position: 'right', title: { display: true, text: 'Orders' }, grid: { drawOnChartArea: false } }
                }
            }
        });
    }

    function createOrdersStatusChart(data) {
        return new Chart(document.getElementById('chart-orders-status'), {
            type: 'doughnut',
            data: {
                labels: data.map(r => r.status),
                datasets: [{
                    data: data.map(r => parseInt(r.orders)),
                    backgroundColor: ['#10b981','#f25c05','#f59e0b','#ef4444','#8b5cf6','#0284c7']
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });
    }

    function createCustomerSegmentsChart(data) {
        return new Chart(document.getElementById('chart-customer-segments'), {
            type: 'bar',
            data: {
                labels: data.map(r => r.segment),
                datasets: [
                    {
                        label: '<?= $block->escapeJs(__('Customers')) ?>',
                        data: data.map(r => parseInt(r.customers)),
                        backgroundColor: 'rgba(242,92,5,0.85)'
                    },
                    {
                        label: '<?= $block->escapeJs(__('Revenue (%1)', $block->getCurrencySymbol())) ?>',
                        data: data.map(r => parseFloat(r.revenue)),
                        backgroundColor: 'rgba(16,185,129,0.85)'
                    }
                ]
            },
            options: { responsive: true }
        });
    }

    function createRevenueDowChart(data) {
        return new Chart(document.getElementById('chart-revenue-dow'), {
            type: 'bar',
            data: {
                labels: data.map(r => r.day_name),
                datasets: [{
                    label: '<?= $block->escapeJs(__('Revenue (%1)', $block->getCurrencySymbol())) ?>',
                    data: data.map(r => parseFloat(r.revenue)),
                    backgroundColor: ['#f25c05','#f97316','#fb923c','#fdba74','#fed7aa','#ffedd5','#fff7ed']
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });
    }

    function createStockDistChart(data) {
        return new Chart(document.getElementById('chart-stock-dist'), {
            type: 'doughnut',
            data: {
                labels: data.map(r => r.stock_range),
                datasets: [{
                    data: data.map(r => parseInt(r.product_count)),
                    backgroundColor: ['#ef4444','#f97316','#f59e0b','#10b981','#f25c05']
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });
    }

    function createRevenueCategoryChart(data) {
        return new Chart(document.getElementById('chart-revenue-category'), {
            type: 'bar',
            data: {
                labels: data.map(r => r.category_name),
                datasets: [{
                    label: '<?= $block->escapeJs(__('Revenue (%1)', $block->getCurrencySymbol())) ?>',
                    data: data.map(r => parseFloat(r.revenue)),
                    backgroundColor: 'rgba(242,92,5,0.85)'
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });
    }

    function updateTopProductsTable(products) {
        let html = '';
        products.forEach((product, i) => {
            html += '<tr>';
            html += '<td>' + (i + 1) + '</td>';
            html += '<td>' + escapeHtml(product.product_name) + '</td>';
            html += '<td class="ai-text-muted">' + escapeHtml(product.sku) + '</td>';
            html += '<td>' + formatNumber(product.qty_sold) + '</td>';
            html += '<td><strong class="ai-text-green">' + CURRENCY + formatNumber(product.revenue, 2) + '</strong></td>';
            html += '<td>' + CURRENCY + formatNumber(product.avg_price, 2) + '</td>';
            html += '<td>' + product.order_count + '</td>';
            html += '</tr>';
        });
        $('#top-products-tbody').html(html);
    }

    function escapeHtml(text) {
        return $('<div>').text(text).html();
    }
});
</script>

<?php endif; ?>
