<script>
require(['jquery', 'chartjs'], function ($, Chart) {
    'use strict';

    const EXECUTE_URL = '<?= $block->escapeJs($block->getQueryExecuteUrl()) ?>';
    const FORM_KEY    = '<?= $block->escapeJs($block->getFormKey()) ?>';

    let dashChart    = null;
    let dashColumns  = [];
    let dashRows     = [];
    let dashSql      = '';
    let activeDashChart = 'table';
    let dashSelectedXAxis = null;
    let dashSelectedYAxis = [];
    
    // Make Chart available globally for debugging
    window.Chart = Chart;

    // ── Load quick stats on page load ──────────────────────────────────────
    const statsQueries = [
        { id: 'stat-today-revenue',   sql: 'SELECT COALESCE(SUM(grand_total), 0) as revenue FROM sales_order WHERE DATE(created_at) = CURDATE() AND status NOT IN ("canceled","closed")' },
        { id: 'stat-today-orders',    sql: 'SELECT COUNT(*) as orders FROM sales_order WHERE DATE(created_at) = CURDATE()' },
        { id: 'stat-new-customers',   sql: 'SELECT COUNT(*) as customers FROM customer_entity WHERE created_at >= DATE_SUB(NOW(), INTERVAL 7 DAY)' },
        { id: 'stat-pending-orders',  sql: 'SELECT COUNT(*) as pending FROM sales_order WHERE status = "pending"' }
    ];

    statsQueries.forEach(function (stat) {
        $.ajax({
            url: EXECUTE_URL,
            type: 'POST',
            data: { sql: stat.sql, form_key: FORM_KEY },
            dataType: 'json',
            success: function (response) {
                if (response.success && response.rows.length > 0) {
                    const val = Object.values(response.rows[0])[0];
                    let formatted;
                    
                    // Handle revenue formatting with currency
                    if (stat.id === 'stat-today-revenue') {
                        const numVal = parseFloat(val) || 0;
                        formatted = '$' + numVal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    } else {
                        // Handle other numeric values
                        const numVal = parseFloat(val);
                        formatted = isNaN(numVal) ? '0' : numVal.toLocaleString();
                    }
                    
                    $('#' + stat.id).text(formatted).closest('.ai-stat-card').removeClass('ai-loading-card');
                } else {
                    // If no data, show 0
                    const formatted = stat.id === 'stat-today-revenue' ? '$0.00' : '0';
                    $('#' + stat.id).text(formatted).closest('.ai-stat-card').removeClass('ai-loading-card');
                }
            },
            error: function() {
                // On error, show 0
                const formatted = stat.id === 'stat-today-revenue' ? '$0.00' : '0';
                $('#' + stat.id).text(formatted).closest('.ai-stat-card').removeClass('ai-loading-card');
            }
        });
    });

    // ── Dashboard quick query ──────────────────────────────────────────────
    $('#ai-dash-query').on('keypress', function (e) {
        if (e.which === 13) { executeDashQuery(); }
    });
    $('#ai-dash-query-btn').on('click', function () { executeDashQuery(); });

    $(document).on('click', '.ai-dash-chart-btn', function () {
        $('.ai-dash-chart-btn').removeClass('active');
        $(this).addClass('active');
        activeDashChart = $(this).data('chart');
        
        // Show/hide axis controls based on chart type
        if (activeDashChart === 'table') {
            $('#ai-dash-axis-controls').hide();
        } else {
            $('#ai-dash-axis-controls').show();
            populateDashAxisSelects();
        }
        
        renderDashView(activeDashChart);
    });

    // ── Apply axis selection ───────────────────────────────────────────────
    $('#ai-dash-apply-axis').on('click', function () {
        dashSelectedXAxis = $('#ai-dash-x-axis-select').val();
        dashSelectedYAxis = $('#ai-dash-y-axis-select').val();
        
        if (activeDashChart !== 'table') {
            renderDashView(activeDashChart);
        }
    });

    // ── Populate axis select dropdowns ─────────────────────────────────────
    function populateDashAxisSelects() {
        if (dashColumns.length === 0) return;
        
        const $xSelect = $('#ai-dash-x-axis-select');
        const $ySelect = $('#ai-dash-y-axis-select');
        
        // Clear existing options except the first one
        $xSelect.find('option:not(:first)').remove();
        $ySelect.find('option:not(:first)').remove();
        
        // Add column options
        dashColumns.forEach(function (col) {
            $xSelect.append($('<option>').val(col).text(col));
            $ySelect.append($('<option>').val(col).text(col));
        });
        
        // Auto-select based on data types if not already selected
        if (!dashSelectedXAxis && !dashSelectedYAxis.length) {
            autoSelectDashAxes();
        } else {
            // Restore previous selections
            if (dashSelectedXAxis) {
                $xSelect.val(dashSelectedXAxis);
            }
            if (dashSelectedYAxis.length) {
                $ySelect.val(dashSelectedYAxis);
            }
        }
    }

    // ── Auto-select axes based on data types ───────────────────────────────
    function autoSelectDashAxes() {
        if (dashRows.length === 0) return;
        
        const firstRow = dashRows[0];
        const ignoredCols = ['entity_id', 'increment_id', 'id'];
        
        // Find first non-numeric column for X-axis (labels)
        const xCol = dashColumns.find(c => !isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase())) || dashColumns[0];
        
        // Find all numeric columns for Y-axis (values)
        const yCols = dashColumns.filter(c => c !== xCol && isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase()));
        
        dashSelectedXAxis = xCol;
        dashSelectedYAxis = yCols.length > 0 ? yCols : [dashColumns[dashColumns.length - 1]];
        
        $('#ai-dash-x-axis-select').val(dashSelectedXAxis);
        $('#ai-dash-y-axis-select').val(dashSelectedYAxis);
    }

    $('#ai-dash-copy-sql').on('click', function () {
        navigator.clipboard.writeText(dashSql).then(function () {
            $('#ai-dash-copy-sql').text('<?= $block->escapeJs(__('Copied!')) ?>');
            setTimeout(function () { $('#ai-dash-copy-sql').text('<?= $block->escapeJs(__('Copy SQL')) ?>'); }, 2000);
        });
    });

    function executeDashQuery() {
        const query = $('#ai-dash-query').val().trim();
        if (!query) { return; }

        $('#ai-dash-loading').show();
        $('#ai-dash-error').hide();
        $('#ai-dash-results').hide();
        $('#ai-dash-query-btn').prop('disabled', true);

        $.ajax({
            url: EXECUTE_URL,
            type: 'POST',
            data: { query: query, form_key: FORM_KEY },
            dataType: 'json',
            success: function (response) {
                $('#ai-dash-loading').hide();
                $('#ai-dash-query-btn').prop('disabled', false);
                if (response.success) {
                    dashSql     = response.sql_query;
                    dashColumns = response.columns;
                    dashRows    = response.rows;
                    $('#ai-dash-sql-display').text(dashSql);
                    $('#ai-dash-row-count').text(response.row_count + ' rows');
                    renderDashView(activeDashChart);
                    $('#ai-dash-results').show();
                } else {
                    $('#ai-dash-error').text(response.message).show();
                }
            },
            error: function () {
                $('#ai-dash-loading').hide();
                $('#ai-dash-query-btn').prop('disabled', false);
                $('#ai-dash-error').text('<?= $block->escapeJs(__('Request failed.')) ?>').show();
            }
        });
    }

    function renderDashView(type) {
        if (type === 'table') {
            $('#ai-dash-chart-container').hide();
            $('#ai-dash-table-container').show();
            renderDashTable();
        } else {
            $('#ai-dash-table-container').hide();
            $('#ai-dash-chart-container').show();
            renderDashChart(type);
        }
    }

    function renderDashTable() {
        let thead = '<tr>' + dashColumns.map(c => '<th>' + escHtml(c) + '</th>').join('') + '</tr>';
        let tbody = dashRows.map(function (row) {
            return '<tr>' + dashColumns.map(c => '<td>' + escHtml(String(row[c] ?? '')) + '</td>').join('') + '</tr>';
        }).join('');
        $('#ai-dash-table-head').html(thead);
        $('#ai-dash-table-body').html(tbody);
    }

    function renderDashChart(type) {
        if (dashChart) { dashChart.destroy(); }
        if (dashColumns.length < 2 || dashRows.length === 0) {
            renderDashView('table'); return;
        }
        
        // Check if Chart is available
        if (typeof Chart === 'undefined') {
            console.error('Chart.js is not loaded');
            renderDashView('table');
            return;
        }
        
        // --- Use selected axes or auto-detect ---
        const firstRow = dashRows[0];
        const ignoredCols = ['entity_id', 'increment_id', 'id'];
        
        let labelCol, valueCols;
        
        // Use selected axes if available
        if (dashSelectedXAxis && dashSelectedYAxis.length > 0) {
            labelCol = dashSelectedXAxis;
            valueCols = dashSelectedYAxis;
        } else {
            // Auto-detect: Labels - first non-numeric column, Values - all numeric columns
            labelCol = dashColumns.find(c => !isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase())) || dashColumns[0];
            valueCols = dashColumns.filter(c => c !== labelCol && isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase()));
            
            if (valueCols.length === 0) {
                valueCols = [dashColumns[dashColumns.length - 1]];
            }
        }
        
        const labels = dashRows.map(r => String(r[labelCol] ?? ''));
        const palette = [
            '#6366f1', '#8b5cf6', '#ec4899', '#f59e0b', '#10b981',
            '#3b82f6', '#ef4444', '#14b8a6', '#f97316', '#84cc16'
        ];
        
        let datasets = [];
        if (type === 'pie') {
            // Pie chart uses only the first value column
            const vCol = valueCols[0];
            const pieColors = generateColors(dashRows.length);
            datasets.push({
                label: vCol,
                data: dashRows.map(r => parseFloat(r[vCol]) || 0),
                backgroundColor: pieColors,
                borderColor: '#ffffff',
                borderWidth: 2
            });
        } else {
            // Bar/Line can show multiple datasets
            valueCols.forEach((vCol, idx) => {
                const color = palette[idx % palette.length];
                datasets.push({
                    label: vCol,
                    data: dashRows.map(r => parseFloat(r[vCol]) || 0),
                    backgroundColor: color + 'BB',
                    borderColor: color,
                    borderWidth: 2,
                    tension: 0.4
                });
            });
        }

        const ctx = document.getElementById('ai-dash-chart').getContext('2d');
        
        try {
            dashChart = new Chart(ctx, {
                type: type,
                data: {
                    labels: labels,
                    datasets: datasets
                },
                options: { 
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: type === 'pie' || datasets.length > 1 },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) { label += ': '; }
                                    const val = context.raw;
                                    label += typeof val === 'number' ? val.toLocaleString() : val;
                                    return label;
                                }
                            }
                        }
                    },
                    scales: type !== 'pie' ? {
                        x: {
                            title: {
                                display: true,
                                text: labelCol
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: valueCols.length === 1 ? valueCols[0] : 'Values'
                            },
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        }
                    } : {}
                }
            });
        } catch (error) {
            console.error('Dashboard chart error:', error);
            renderDashView('table');
        }
    }
    
    function isNumeric(value) {
        return !isNaN(parseFloat(value)) && isFinite(value);
    }

    function generateColors(count) {
        const palette = [
            '#6366f1','#8b5cf6','#ec4899','#f59e0b','#10b981',
            '#3b82f6','#ef4444','#14b8a6','#f97316','#84cc16'
        ];
        return Array.from({ length: count }, (_, i) => palette[i % palette.length]);
    }

    function escHtml(str) { return $('<div>').text(str).html(); }
});
</script>

<?php endif; ?>
