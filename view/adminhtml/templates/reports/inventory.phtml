<script>
require(['jquery', 'chartjs'], function($, Chart) {
    $('.ai-tab-btn').on('click', function() {
        $('.ai-tab-btn').removeClass('active');
        $(this).addClass('active');
        $('.ai-tab-panel').hide();
        $('#tab-' + $(this).data('tab')).show();
    });

    var distData = <?= /* @noEscape */ json_encode(array_values($stockDist), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    new Chart(document.getElementById('chart-stock-dist'), {
        type: 'doughnut',
        data: {
            labels: distData.map(r => r.stock_range),
            datasets: [{
                data: distData.map(r => parseInt(r.product_count)),
                backgroundColor: ['#ef4444','#f97316','#f59e0b','#10b981','#6366f1','#8b5cf6']
            }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });

    // ── Demand vs Supply (period-aware) ────────────────────────────────────
    var demandByPeriod = <?= /* @noEscape */ json_encode($demandPeriod, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var periodLabels = {
        today: '<?= $block->escapeJs(__('(Today)')) ?>',
        week:  '<?= $block->escapeJs(__('(This Week)')) ?>',
        month: '<?= $block->escapeJs(__('(This Month)')) ?>',
        year:  '<?= $block->escapeJs(__('(This Year)')) ?>'
    };
    var demandChart = null;
    var EMPTY_MSG = '<?= $block->escapeJs(__('No sales in this period')) ?>';

    function drawEmpty(canvas) {
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.save();
        ctx.font = '14px sans-serif'; ctx.fillStyle = '#9ca3af'; ctx.textAlign = 'center';
        ctx.fillText(EMPTY_MSG, canvas.width / 2, canvas.height / 2);
        ctx.restore();
    }

    function renderDemand(period) {
        var data = demandByPeriod[period] || [];
        $('#ai-demand-period-label').text(periodLabels[period] || '');
        var canvas = document.getElementById('chart-demand-supply');
        if (demandChart) { demandChart.destroy(); demandChart = null; }
        if (!data.length) { drawEmpty(canvas); return; }

        demandChart = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: data.map(function(r){ return r.sku; }),
                datasets: [
                    { label: '<?= $block->escapeJs(__('Qty Sold')) ?>', data: data.map(function(r){ return parseFloat(r.qty_sold_30d); }), backgroundColor: 'rgba(99,102,241,0.8)' },
                    { label: '<?= $block->escapeJs(__('Current Stock')) ?>', data: data.map(function(r){ return parseFloat(r.current_stock); }), backgroundColor: 'rgba(16,185,129,0.8)' }
                ]
            },
            options: { responsive: true }
        });
    }

    // Period tabs — only the demand chart is period-sensitive (stock KPIs are current)
    $('.ai-period-tab').on('click', function() {
        $('.ai-period-tab').removeClass('active');
        $(this).addClass('active');
        renderDemand($(this).data('period'));
    });

    renderDemand('month');
});
</script>
