<script>
require(['jquery', 'chartjs'], function($, Chart) {
    $('.ai-tab-btn').on('click', function() {
        $('.ai-tab-btn').removeClass('active');
        $(this).addClass('active');
        $('.ai-tab-panel').hide();
        $('#tab-' + $(this).data('tab')).show();
    });

    var distData = <?= /* @noEscape */ json_encode(array_values($stockDist)) ?>;
    new Chart(document.getElementById('chart-stock-dist'), {
        type: 'doughnut',
        data: {
            labels: distData.map(r => r.stock_range),
            datasets: [{
                data: distData.map(r => parseInt(r.product_count)),
                backgroundColor: ['#ef4444','#f97316','#f59e0b','#10b981','#6366f1','#8b5cf6']
            }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });

    var demandData = <?= /* @noEscape */ json_encode(array_values($demand)) ?>;
    new Chart(document.getElementById('chart-demand-supply'), {
        type: 'bar',
        data: {
            labels: demandData.map(r => r.sku),
            datasets: [
                {
                    label: '<?= $block->escapeJs(__('Qty Sold (30d)')) ?>',
                    data: demandData.map(r => parseFloat(r.qty_sold_30d)),
                    backgroundColor: 'rgba(99,102,241,0.8)'
                },
                {
                    label: '<?= $block->escapeJs(__('Current Stock')) ?>',
                    data: demandData.map(r => parseFloat(r.current_stock)),
                    backgroundColor: 'rgba(16,185,129,0.8)'
                }
            ]
        },
        options: { responsive: true }
    });
});
</script>
