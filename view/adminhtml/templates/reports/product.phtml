<script>
require(['jquery', 'chartjs'], function($, Chart) {
    // Tab switching
    $('.ai-tab-btn').on('click', function() {
        $('.ai-tab-btn').removeClass('active');
        $(this).addClass('active');
        $('.ai-tab-panel').hide();
        $('#tab-' + $(this).data('tab')).show();
    });

    // Top 10 by Revenue
    var top10 = <?= /* @noEscape */ json_encode(array_values(array_slice($byRevenue, 0, 10))) ?>;
    new Chart(document.getElementById('chart-top-revenue'), {
        type: 'bar',
        data: {
            labels: top10.map(r => r.sku),
            datasets: [{
                label: '<?= $block->escapeJs(__('Revenue ($)')) ?>',
                data: top10.map(r => parseFloat(r.total_revenue)),
                backgroundColor: 'rgba(99,102,241,0.8)',
                borderColor: 'rgba(99,102,241,1)',
                borderWidth: 1
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: { legend: { display: false } }
        }
    });

    // Product Type Pie
    var typeData = <?= /* @noEscape */ json_encode(array_values($byType)) ?>;
    new Chart(document.getElementById('chart-product-type'), {
        type: 'pie',
        data: {
            labels: typeData.map(r => r.product_type),
            datasets: [{
                data: typeData.map(r => parseFloat(r.total_revenue)),
                backgroundColor: ['#6366f1','#10b981','#f59e0b','#ef4444','#8b5cf6']
            }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });

    <?php if (!empty($byCategory)): ?>
    var catData = <?= /* @noEscape */ json_encode(array_values($byCategory)) ?>;
    new Chart(document.getElementById('chart-category'), {
        type: 'bar',
        data: {
            labels: catData.map(r => r.category_name),
            datasets: [{
                label: '<?= $block->escapeJs(__('Revenue ($)')) ?>',
                data: catData.map(r => parseFloat(r.total_revenue)),
                backgroundColor: 'rgba(16,185,129,0.8)'
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });
    <?php endif; ?>
});
</script>
