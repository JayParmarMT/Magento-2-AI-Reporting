<script>
require(['jquery', 'chartjs'], function($, Chart) {
    // Tab switching
    $('.ai-tab-btn').on('click', function() {
        $('.ai-tab-btn').removeClass('active');
        $(this).addClass('active');
        $('.ai-tab-panel').hide();
        $('#tab-' + $(this).data('tab')).show();
    });

    // ── Per-period data ────────────────────────────────────────────────────
    var topRevByPeriod = <?= /* @noEscape */ json_encode($topRevPeriod, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var typeByPeriod   = <?= /* @noEscape */ json_encode($typePeriod, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

    var periodLabels = {
        today: '<?= $block->escapeJs(__('(Today)')) ?>',
        week:  '<?= $block->escapeJs(__('(This Week)')) ?>',
        month: '<?= $block->escapeJs(__('(This Month)')) ?>',
        year:  '<?= $block->escapeJs(__('(This Year)')) ?>'
    };

    var topRevChart = null, typeChart = null;
    var EMPTY_MSG = '<?= $block->escapeJs(__('No data in this period')) ?>';

    function drawEmpty(canvas) {
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.save();
        ctx.font = '14px sans-serif'; ctx.fillStyle = '#9ca3af'; ctx.textAlign = 'center';
        ctx.fillText(EMPTY_MSG, canvas.width / 2, canvas.height / 2);
        ctx.restore();
    }

    function renderTopRev(period) {
        var data = topRevByPeriod[period] || [];
        $('#ai-toprev-period-label').text(periodLabels[period] || '');
        var canvas = document.getElementById('chart-top-revenue');
        if (topRevChart) { topRevChart.destroy(); topRevChart = null; }
        if (!data.length) { drawEmpty(canvas); return; }

        topRevChart = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: data.map(function(r){ return r.sku; }),
                datasets: [{
                    label: '<?= $block->escapeJs(__('Revenue ($)')) ?>',
                    data: data.map(function(r){ return parseFloat(r.total_revenue); }),
                    backgroundColor: 'rgba(99,102,241,0.8)',
                    borderColor: 'rgba(99,102,241,1)',
                    borderWidth: 1
                }]
            },
            options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } } }
        });
    }

    function renderType(period) {
        var data = typeByPeriod[period] || [];
        $('#ai-ptype-period-label').text(periodLabels[period] || '');
        var canvas = document.getElementById('chart-product-type');
        if (typeChart) { typeChart.destroy(); typeChart = null; }
        if (!data.length) { drawEmpty(canvas); return; }

        typeChart = new Chart(canvas, {
            type: 'pie',
            data: {
                labels: data.map(function(r){ return r.product_type; }),
                datasets: [{
                    data: data.map(function(r){ return parseFloat(r.total_revenue); }),
                    backgroundColor: ['#6366f1','#10b981','#f59e0b','#ef4444','#8b5cf6']
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });
    }

    function renderPeriodCharts(period) {
        renderTopRev(period);
        renderType(period);
    }

    // Period tabs — update KPI panels AND the period-aware charts
    $('.ai-period-tab').on('click', function() {
        $('.ai-period-tab').removeClass('active');
        $(this).addClass('active');
        var period = $(this).data('period');
        $('.ai-kpi-panel').hide();
        $('.ai-kpi-panel[data-period="' + period + '"]').show();
        renderPeriodCharts(period);
    });

    renderPeriodCharts('month');

    <?php if (!empty($byCategory)): ?>
    var catData = <?= /* @noEscape */ json_encode(array_values($byCategory), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    new Chart(document.getElementById('chart-category'), {
        type: 'bar',
        data: {
            labels: catData.map(r => r.category_name),
            datasets: [{
                label: '<?= $block->escapeJs(__('Revenue ($)')) ?>',
                data: catData.map(r => parseFloat(r.total_revenue)),
                backgroundColor: 'rgba(16,185,129,0.8)'
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });
    <?php endif; ?>
});
</script>
