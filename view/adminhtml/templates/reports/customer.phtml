<script>
require(['jquery', 'chartjs'], function($, Chart) {
    var nvr = <?= /* @noEscape */ json_encode(array_values($newVsReturn)) ?>;
    new Chart(document.getElementById('chart-new-vs-returning'), {
        type: 'bar',
        data: {
            labels: nvr.map(r => r.label),
            datasets: [
                {
                    label: '<?= $block->escapeJs(__('New Customers')) ?>',
                    data: nvr.map(r => parseInt(r.new_customers || 0)),
                    backgroundColor: 'rgba(99,102,241,0.8)'
                },
                {
                    label: '<?= $block->escapeJs(__('Returning Customers')) ?>',
                    data: nvr.map(r => parseInt(r.returning_customers || 0)),
                    backgroundColor: 'rgba(16,185,129,0.8)'
                }
            ]
        },
        options: { responsive: true, scales: { x: { stacked: true }, y: { stacked: true } } }
    });

    var clv = <?= /* @noEscape */ json_encode(array_values($clvDist)) ?>;
    new Chart(document.getElementById('chart-clv-dist'), {
        type: 'doughnut',
        data: {
            labels: clv.map(r => r.clv_range),
            datasets: [{
                data: clv.map(r => parseInt(r.customer_count)),
                backgroundColor: ['#e5e7eb','#a5b4fc','#818cf8','#6366f1','#4f46e5']
            }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });
});
</script>
