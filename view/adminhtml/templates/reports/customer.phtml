<script>
require(['jquery', 'chartjs'], function($, Chart) {
    var nvrByPeriod = <?= /* @noEscape */ json_encode($newVsReturn, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var clvByPeriod = <?= /* @noEscape */ json_encode($clvDist, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

    var periodLabels = {
        today: '<?= $block->escapeJs(__('(Today)')) ?>',
        week:  '<?= $block->escapeJs(__('(This Week)')) ?>',
        month: '<?= $block->escapeJs(__('(This Month)')) ?>',
        year:  '<?= $block->escapeJs(__('(This Year)')) ?>'
    };

    var nvrChart = null, clvChart = null;
    var EMPTY_MSG = '<?= $block->escapeJs(__('No data in this period')) ?>';

    function drawEmpty(canvas) {
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.save();
        ctx.font = '14px sans-serif'; ctx.fillStyle = '#9ca3af'; ctx.textAlign = 'center';
        ctx.fillText(EMPTY_MSG, canvas.width / 2, canvas.height / 2);
        ctx.restore();
    }

    function renderNvr(period) {
        var data = nvrByPeriod[period] || [];
        $('#ai-nvr-period-label').text(periodLabels[period] || '');
        var canvas = document.getElementById('chart-new-vs-returning');
        if (nvrChart) { nvrChart.destroy(); nvrChart = null; }
        var hasData = data.some(function(r){ return (parseInt(r.new_customers)||0) > 0 || (parseInt(r.returning_customers)||0) > 0; });
        if (!data.length || !hasData) { drawEmpty(canvas); return; }

        nvrChart = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: data.map(function(r){ return r.label; }),
                datasets: [
                    { label: '<?= $block->escapeJs(__('New Customers')) ?>', data: data.map(function(r){ return parseInt(r.new_customers || 0); }), backgroundColor: 'rgba(99,102,241,0.8)' },
                    { label: '<?= $block->escapeJs(__('Returning Customers')) ?>', data: data.map(function(r){ return parseInt(r.returning_customers || 0); }), backgroundColor: 'rgba(16,185,129,0.8)' }
                ]
            },
            options: { responsive: true, scales: { x: { stacked: true }, y: { stacked: true } } }
        });
    }

    function renderClv(period) {
        var data = clvByPeriod[period] || [];
        $('#ai-clv-period-label').text(periodLabels[period] || '');
        var canvas = document.getElementById('chart-clv-dist');
        if (clvChart) { clvChart.destroy(); clvChart = null; }
        var hasData = data.some(function(r){ return (parseInt(r.customer_count)||0) > 0; });
        if (!data.length || !hasData) { drawEmpty(canvas); return; }

        clvChart = new Chart(canvas, {
            type: 'doughnut',
            data: {
                labels: data.map(function(r){ return r.clv_range; }),
                datasets: [{
                    data: data.map(function(r){ return parseInt(r.customer_count); }),
                    backgroundColor: ['#e5e7eb','#a5b4fc','#818cf8','#6366f1','#4f46e5']
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });
    }

    function renderAll(period) {
        renderNvr(period);
        renderClv(period);
    }

    $('.ai-period-tab').on('click', function() {
        $('.ai-period-tab').removeClass('active');
        $(this).addClass('active');
        var period = $(this).data('period');
        $('.ai-kpi-panel').hide();
        $('.ai-kpi-panel[data-period="' + period + '"]').show();
        renderAll(period);
    });

    renderAll('month');
});
</script>
