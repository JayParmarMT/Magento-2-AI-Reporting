<script>
require(['jquery', 'chartjs'], function($, Chart) {
    // Period tabs
    $('.ai-period-tab').on('click', function() {
        $('.ai-period-tab').removeClass('active');
        $(this).addClass('active');
        var period = $(this).data('period');
        $('.ai-kpi-panel').hide();
        $('.ai-kpi-panel[data-period="' + period + '"]').show();
    });

    // Monthly Revenue Chart
    var monthlyData = <?= /* @noEscape */ json_encode(array_values($monthly)) ?>;
    new Chart(document.getElementById('chart-revenue-monthly'), {
        type: 'bar',
        data: {
            labels: monthlyData.map(r => r.label),
            datasets: [
                {
                    label: '<?= $block->escapeJs(__('Revenue ($)')) ?>',
                    data: monthlyData.map(r => parseFloat(r.revenue)),
                    backgroundColor: 'rgba(99,102,241,0.8)',
                    borderColor: 'rgba(99,102,241,1)',
                    borderWidth: 1,
                    yAxisID: 'y'
                },
                {
                    label: '<?= $block->escapeJs(__('Orders')) ?>',
                    data: monthlyData.map(r => parseInt(r.orders)),
                    type: 'line',
                    borderColor: 'rgba(16,185,129,1)',
                    backgroundColor: 'rgba(16,185,129,0.1)',
                    borderWidth: 2,
                    fill: false,
                    yAxisID: 'y1',
                    tension: 0.4
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            scales: {
                y:  { type: 'linear', position: 'left',  title: { display: true, text: 'Revenue ($)' } },
                y1: { type: 'linear', position: 'right', title: { display: true, text: 'Orders' }, grid: { drawOnChartArea: false } }
            }
        }
    });

    // Order Status Pie
    var statusData = <?= /* @noEscape */ json_encode(array_values($statuses)) ?>;
    new Chart(document.getElementById('chart-order-status'), {
        type: 'doughnut',
        data: {
            labels: statusData.map(r => r.status),
            datasets: [{
                data: statusData.map(r => parseInt(r.orders)),
                backgroundColor: ['#10b981','#6366f1','#f59e0b','#ef4444','#8b5cf6','#14b8a6']
            }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });

    // Daily Revenue Line
    var dailyData = <?= /* @noEscape */ json_encode(array_values($daily)) ?>;
    new Chart(document.getElementById('chart-revenue-daily'), {
        type: 'line',
        data: {
            labels: dailyData.map(r => r.label),
            datasets: [{
                label: '<?= $block->escapeJs(__('Revenue ($)')) ?>',
                data: dailyData.map(r => parseFloat(r.revenue)),
                borderColor: 'rgba(99,102,241,1)',
                backgroundColor: 'rgba(99,102,241,0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });

    // Day of Week Bar
    var dowData = <?= /* @noEscape */ json_encode(array_values($dow)) ?>;
    new Chart(document.getElementById('chart-dow'), {
        type: 'bar',
        data: {
            labels: dowData.map(r => r.day_name),
            datasets: [{
                label: '<?= $block->escapeJs(__('Revenue ($)')) ?>',
                data: dowData.map(r => parseFloat(r.revenue)),
                backgroundColor: ['#6366f1','#8b5cf6','#a78bfa','#c4b5fd','#ddd6fe','#ede9fe','#f5f3ff']
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });
});
</script>
