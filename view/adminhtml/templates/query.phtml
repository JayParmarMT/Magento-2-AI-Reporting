<script>
require(['jquery', 'chartjs', 'Magento_Ui/js/modal/alert'], function ($, Chart, alert) {
    'use strict';

    const EXECUTE_URL  = '<?= $block->escapeJs($block->getQueryExecuteUrl()) ?>';
    const SAVE_URL     = '<?= $block->escapeJs($block->getSaveReportUrl()) ?>';
    const CHAT_URL     = '<?= $block->escapeJs($block->getChatSendUrl()) ?>';
    const FORM_KEY     = '<?= $block->escapeJs($block->getFormKey()) ?>';

    let currentSql     = '';
    let currentNlp     = '';
    let currentToken   = '';
    const CHART_TYPES  = ['table', 'bar', 'line', 'pie'];
    let currentColumns = [];
    let currentRows    = [];
    let chartInstance  = null;
    let activeChart    = 'table';
    let selectedXAxis  = null;
    let selectedYAxis  = [];
    
    window.Chart = Chart;

    $(document).ready(function () {
        const savedReportData = sessionStorage.getItem('ai_run_saved_report');
        if (savedReportData) {
            try {
                const data = JSON.parse(savedReportData);
                sessionStorage.removeItem('ai_run_saved_report');
                
                if (data.nlp) {
                    $('#ai-nlp-query').val(data.nlp);
                }
                
                const reportId = parseInt(data.report_id, 10);
                if (reportId > 0) {
                    currentNlp  = data.nlp || '';
                    activeChart = CHART_TYPES.indexOf(data.chart) !== -1 ? data.chart : 'table';

                    executeSavedQuery(reportId, activeChart);
                }
            } catch (e) {
                console.error('Failed to parse saved report data:', e);
            }
        }
    });

    function executeSavedQuery(reportId, chartType) {
        showLoading(true);
        hideError();
        $('#ai-results').hide();

        $.ajax({
            url: EXECUTE_URL,
            type: 'POST',
            data: { report_id: reportId, form_key: FORM_KEY },
            dataType: 'json',
            success: function (response) {
                showLoading(false);
                if (response.success) {
                    currentSql     = response.sql_query;
                    currentToken   = response.query_token || '';
                    currentColumns = response.columns;
                    currentRows    = response.rows;

                    $('#ai-sql-display').text(currentSql);
                    $('#ai-row-count').text(response.row_count + ' <?= $block->escapeJs(__('rows')) ?>');
                    $('#ai-exec-time').text('⚡ ' + response.execution_time_ms + ' ms');
                    showAssumption('');

                    $('.ai-chart-btn').removeClass('active');
                    $('.ai-chart-btn[data-chart="' + chartType + '"]').addClass('active');
                    activeChart = chartType;

                    renderView(activeChart);
                    $('#ai-results').show();
                } else {
                    showError(response.message || '<?= $block->escapeJs(__('An error occurred.')) ?>');
                }
            },
            error: function (xhr) {
                showLoading(false);
                showError('<?= $block->escapeJs(__('Request failed. Please try again.')) ?>');
            }
        });
    }

    $(document).on('click', '.ai-suggestion-chip', function () {
        $('#ai-nlp-query').val($(this).data('query'));
        executeQuery();
    });

    $('#ai-nlp-query').on('keypress', function (e) {
        if (e.which === 13) { executeQuery(); }
    });

    $('#ai-query-btn').on('click', function () { executeQuery(); });

    $(document).on('click', '.ai-chart-btn', function () {
        $('.ai-chart-btn').removeClass('active');
        $(this).addClass('active');
        activeChart = $(this).data('chart');
        
        if (activeChart === 'table') {
            $('#ai-axis-controls').hide();
        } else {
            $('#ai-axis-controls').show();
            populateAxisSelects();
        }
        
        renderView(activeChart);
    });

    $('#ai-apply-axis').on('click', function () {
        selectedXAxis = $('#ai-x-axis-select').val();
        selectedYAxis = $('#ai-y-axis-select').val();
        
        if (activeChart !== 'table') {
            renderView(activeChart);
        }
    });

    function populateAxisSelects() {
        if (currentColumns.length === 0) return;
        
        const $xSelect = $('#ai-x-axis-select');
        const $ySelect = $('#ai-y-axis-select');
        
        $xSelect.find('option:not(:first)').remove();
        $ySelect.find('option:not(:first)').remove();
        
        currentColumns.forEach(function (col) {
            $xSelect.append($('<option>').val(col).text(col));
            $ySelect.append($('<option>').val(col).text(col));
        });
        
        if (!selectedXAxis && !selectedYAxis.length) {
            autoSelectAxes();
        } else {
            if (selectedXAxis) {
                $xSelect.val(selectedXAxis);
            }
            if (selectedYAxis.length) {
                $ySelect.val(selectedYAxis);
            }
        }
    }

    function autoSelectAxes() {
        if (currentRows.length === 0) return;
        
        const firstRow = currentRows[0];
        const ignoredCols = ['entity_id', 'increment_id', 'id'];
        
        const xCol = currentColumns.find(c => !isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase())) || currentColumns[0];
        const yCols = currentColumns.filter(c => c !== xCol && isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase()));
        
        selectedXAxis = xCol;
        selectedYAxis = yCols.length > 0 ? yCols : [currentColumns[currentColumns.length - 1]];
        
        $('#ai-x-axis-select').val(selectedXAxis);
        $('#ai-y-axis-select').val(selectedYAxis);
    }

    $('#ai-copy-sql').on('click', function () {
        navigator.clipboard.writeText(currentSql).then(function () {
            $('#ai-copy-sql').text('<?= $block->escapeJs(__('Copied!')) ?>');
            setTimeout(function () {
                $('#ai-copy-sql').text('<?= $block->escapeJs(__('Copy SQL')) ?>');
            }, 2000);
        });
    });

    $('#ai-download-csv').on('click', function () {
        downloadCsv(currentColumns, currentRows);
    });

    $('#ai-save-report-btn').on('click', function () {
        $('#ai-save-modal').show();
        $('#ai-report-title').focus();
    });

    $('#ai-modal-close, #ai-modal-cancel').on('click', function () {
        $('#ai-save-modal').hide();
    });

    $('#ai-modal-save').on('click', function () {
        const title = $('#ai-report-title').val().trim();
        if (!title) {
            $('#ai-report-title').addClass('ai-input-error');
            return;
        }
        saveReport(title);
    });

    function executeQuery() {
        const query = $('#ai-nlp-query').val().trim();
        if (!query) { return; }

        currentNlp = query;
        showLoading(true);
        hideError();
        $('#ai-results').hide();

        $.ajax({
            url: EXECUTE_URL,
            type: 'POST',
            data: { query: query, form_key: FORM_KEY },
            dataType: 'json',
            success: function (response) {
                showLoading(false);
                if (response.success) {
                    currentSql     = response.sql_query;
                    currentToken   = response.query_token || '';
                    currentColumns = response.columns;
                    currentRows    = response.rows;

                    $('#ai-sql-display').text(currentSql);
                    $('#ai-row-count').text(response.row_count + ' <?= $block->escapeJs(__('rows')) ?>');
                    $('#ai-exec-time').text('⚡ ' + response.execution_time_ms + ' ms');
                    showAssumption(response.assumption);

                    renderView(activeChart);
                    $('#ai-results').show();
                } else {
                    showError(response.message || '<?= $block->escapeJs(__('An error occurred.')) ?>');
                }
            },
            error: function (xhr) {
                showLoading(false);
                showError('<?= $block->escapeJs(__('Request failed. Please try again.')) ?>');
            }
        });
    }

    function hasMeaningfulData(columns, rows) {
        if (!columns || columns.length === 0 || !rows || rows.length === 0) {
            return false;
        }
        for (let i = 0; i < rows.length; i++) {
            for (let j = 0; j < columns.length; j++) {
                const v = rows[i][columns[j]];
                if (v !== null && v !== undefined && String(v).trim() !== '') {
                    return true;
                }
            }
        }
        return false;
    }

    function toggleResultControls(show) {
        const disp = show ? '' : 'none';
        $('.ai-chart-controls').css('display', disp);
        $('.ai-actions').css('display', disp);
        if (!show) {
            $('#ai-axis-controls').hide();
        }
    }

    function showAssumption(text) {
        const $box = $('#ai-assumption');
        if (text) {
            $box.text('<?= $block->escapeJs(__('Interpreted as:')) ?> ' + text).show();
        } else {
            $box.hide().text('');
        }
    }

    function renderView(type) {
        if (!hasMeaningfulData(currentColumns, currentRows)) {
            $('#ai-chart-container').hide();
            $('#ai-table-container').hide();
            $('#ai-no-data').show();
            toggleResultControls(false);
            return;
        }

        $('#ai-no-data').hide();
        toggleResultControls(true);

        if (type === 'table') {
            $('#ai-chart-container').hide();
            $('#ai-table-container').show();
            renderTable(currentColumns, currentRows);
        } else {
            $('#ai-table-container').hide();
            $('#ai-chart-container').show();
            renderChart(type, currentColumns, currentRows);
        }
    }

    function renderTable(columns, rows) {
        let thead = '<tr>' + columns.map(c => '<th>' + escHtml(c) + '</th>').join('') + '</tr>';
        let tbody = rows.map(function (row) {
            return '<tr>' + columns.map(c => '<td>' + escHtml(String(row[c] ?? '')) + '</td>').join('') + '</tr>';
        }).join('');
        $('#ai-table-head').html(thead);
        $('#ai-table-body').html(tbody);
    }

    function renderChart(type, columns, rows) {
        if (chartInstance) { chartInstance.destroy(); }

        if (columns.length < 2 || rows.length === 0) {
            $('#ai-chart-container').hide();
            $('#ai-table-container').show();
            renderTable(columns, rows);
            return;
        }

        if (typeof Chart === 'undefined') {
            console.error('Chart.js is not loaded');
            showError('<?= $block->escapeJs(__('Chart library failed to load. Please refresh the page.')) ?>');
            $('#ai-chart-container').hide();
            $('#ai-table-container').show();
            renderTable(columns, rows);
            return;
        }

        const firstRow = rows[0];
        const ignoredCols = ['entity_id', 'increment_id', 'id'];
        
        let labelCol, valueCols;
        
        if (selectedXAxis && selectedYAxis.length > 0) {
            labelCol = selectedXAxis;
            valueCols = selectedYAxis;
        } else {
            labelCol = columns.find(c => !isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase())) || columns[0];
            valueCols = columns.filter(c => c !== labelCol && isNumeric(firstRow[c]) && !ignoredCols.includes(c.toLowerCase()));
            
            if (valueCols.length === 0) {
                valueCols = [columns[columns.length - 1]];
            }
        }
        
        const labels = rows.map(r => String(r[labelCol] ?? ''));
        const palette = [
            '#4f46e5', '#8b5cf6', '#ec4899', '#f59e0b', '#10b981',
            '#0284c7', '#ef4444', '#14b8a6', '#f97316', '#84cc16'
        ];
        
        let datasets = [];
        if (type === 'pie') {
            const vCol = valueCols[0];
            const pieColors = generateColors(rows.length);
            datasets.push({
                label: vCol,
                data: rows.map(r => parseFloat(r[vCol]) || 0),
                backgroundColor: pieColors,
                borderColor: '#ffffff',
                borderWidth: 2
            });
        } else {
            valueCols.forEach((vCol, idx) => {
                const color = palette[idx % palette.length];
                datasets.push({
                    label: vCol,
                    data: rows.map(r => parseFloat(r[vCol]) || 0),
                    backgroundColor: type === 'area' ? color + '33' : color + 'BB',
                    borderColor: color,
                    borderWidth: 2,
                    fill: type === 'area',
                    tension: 0.4
                });
            });
        }

        const ctx = document.getElementById('ai-chart').getContext('2d');
        
        try {
            chartInstance = new Chart(ctx, {
                type: type === 'area' ? 'line' : type,
                data: {
                    labels: labels,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: type === 'pie' || datasets.length > 1 },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) { label += ': '; }
                                    const val = context.raw;
                                    label += typeof val === 'number' ? val.toLocaleString() : val;
                                    return label;
                                }
                            }
                        }
                    },
                    scales: type !== 'pie' ? {
                        x: {
                            title: {
                                display: true,
                                text: labelCol
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: valueCols.length === 1 ? valueCols[0] : 'Values'
                            },
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        }
                    } : {}
                }
            });
        } catch (error) {
            console.error('Chart rendering error:', error);
            showError('<?= $block->escapeJs(__('Failed to render chart. Showing table instead.')) ?>');
            $('#ai-chart-container').hide();
            $('#ai-table-container').show();
            renderTable(columns, rows);
        }
    }
    
    function isNumeric(value) {
        return !isNaN(parseFloat(value)) && isFinite(value);
    }

    function saveReport(title) {
        $.ajax({
            url: SAVE_URL,
            type: 'POST',
            data: {
                title:       title,
                query_token: currentToken,
                chart_type:  activeChart,
                form_key:   FORM_KEY
            },
            dataType: 'json',
            success: function (response) {
                $('#ai-save-modal').hide();
                if (response.success) {
                    showSuccessMessage(response.message);
                } else {
                    showError(response.message);
                }
            },
            error: function () {
                $('#ai-save-modal').hide();
                showError('<?= $block->escapeJs(__('Failed to save report.')) ?>');
            }
        });
    }

    function downloadCsv(columns, rows) {
        let csv = columns.join(',') + '\n';
        rows.forEach(function (row) {
            csv += columns.map(c => '"' + String(row[c] ?? '').replace(/"/g, '""') + '"').join(',') + '\n';
        });
        const blob = new Blob([csv], { type: 'text/csv' });
        const url  = URL.createObjectURL(blob);
        const a    = document.createElement('a');
        a.href     = url;
        a.download = 'ai_report_' + Date.now() + '.csv';
        a.click();
        URL.revokeObjectURL(url);
    }

    function showLoading(show) {
        $('#ai-loading').toggle(show);
        $('#ai-query-btn').prop('disabled', show);
    }

    function showError(msg) {
        $('#ai-error').text(msg).show();
    }

    function hideError() {
        $('#ai-error').hide().text('');
    }

    function showSuccessMessage(msg) {
        $('<div class="ai-success-toast">' + escHtml(msg) + '</div>')
            .appendTo('body')
            .delay(3000)
            .fadeOut(400, function () { $(this).remove(); });
    }

    function escHtml(str) {
        return $('<div>').text(str).html();
    }

    function generateColors(count) {
        const palette = [
            '#4f46e5','#8b5cf6','#ec4899','#f59e0b','#10b981',
            '#0284c7','#ef4444','#14b8a6','#f97316','#84cc16'
        ];
        return Array.from({ length: count }, (_, i) => palette[i % palette.length]);
    }

    // ═══ CHAT WITH AI ═══
    let chatBusy = false;

    $('#ai-chat-input').on('keypress', function (e) {
        if (e.which === 13 && !chatBusy) { sendChatMessage(); }
    });

    $('#ai-chat-send').on('click', function () {
        if (!chatBusy) { sendChatMessage(); }
    });

    $(document).on('click', '.ai-chat-quick-btn', function () {
        const msg = $(this).data('msg');
        $('#ai-chat-input').val(msg);
        sendChatMessage();
    });

    $('#ai-chat-clear').on('click', function () {
        const $messages = $('#ai-chat-messages');
        $messages.find('.ai-chat-msg').not(':first').remove();
        $('#ai-chat-input').val('').focus();
        $.post(CHAT_URL, { reset: 1, form_key: FORM_KEY, isAjax: true });
    });

    function sendChatMessage() {
        const message = $('#ai-chat-input').val().trim();
        if (!message || chatBusy) return;

        chatBusy = true;
        $('#ai-chat-input').val('');
        $('#ai-chat-send').prop('disabled', true);

        appendChatMessage('user', message);

        $('#ai-chat-typing').show();
        scrollChatToBottom();

        $.ajax({
            url: CHAT_URL,
            type: 'POST',
            data: { message: message, form_key: FORM_KEY },
            dataType: 'json',
            timeout: 120000,
            success: function (response) {
                $('#ai-chat-typing').hide();
                chatBusy = false;
                $('#ai-chat-send').prop('disabled', false);

                if (response.success) {
                    appendChatMessage('bot', response.answer, {
                        sql: response.sql,
                        rows: response.rows,
                        time_ms: response.time_ms,
                        assumption: response.assumption || ''
                    });
                } else {
                    appendChatMessage('bot', '❌ ' + (response.message || 'Something went wrong. Please try again.'));
                }
            },
            error: function (xhr) {
                $('#ai-chat-typing').hide();
                chatBusy = false;
                $('#ai-chat-send').prop('disabled', false);

                let errMsg = 'Request failed. Please try again.';
                if (xhr.status === 0) {
                    errMsg = 'Network error — check your connection.';
                } else if (xhr.status === 504 || xhr.statusText === 'timeout') {
                    errMsg = 'The request timed out. Try a simpler question.';
                }
                appendChatMessage('bot', '❌ ' + errMsg);
            }
        });

        $('#ai-chat-input').focus();
    }

    function appendChatMessage(role, content, meta) {
        const isBot = role === 'bot';
        const avatarSvg = isBot
            ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/></svg>'
            : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0F172A" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        let html = '<div class="ai-chat-msg ai-chat-msg-' + role + '">';
        html += '<div class="ai-chat-msg-avatar">' + avatarSvg + '</div>';
        html += '<div class="ai-chat-msg-bubble">';

        if (isBot) {
            html += '<div class="ai-chat-msg-text">' + formatBotMessage(content) + '</div>';
            if (meta && meta.assumption) {
                html += '<div class="ai-assumption ai-assumption-chat">'
                    + escHtml('<?= $block->escapeJs(__('Interpreted as:')) ?> ' + meta.assumption) + '</div>';
            }

            if (meta && meta.sql) {
                html += '<div class="ai-chat-meta">';
                if (meta.rows !== undefined) {
                    html += '<span class="ai-chat-meta-item">📊 ' + meta.rows + ' rows</span>';
                }
                if (meta.time_ms !== undefined) {
                    html += '<span class="ai-chat-meta-item">⚡ ' + meta.time_ms + 'ms</span>';
                }
                if (meta.sql) {
                    html += '<button type="button" class="ai-chat-sql-toggle">Show SQL ▼</button>';
                    html += '<pre class="ai-chat-sql-code" style="display:none;">' + escHtml(meta.sql) + '</pre>';
                }
                html += '</div>';
            }
        } else {
            html += '<div class="ai-chat-msg-text">' + escHtml(content) + '</div>';
        }

        html += '<div class="ai-chat-msg-time">' + time + '</div>';
        html += '</div></div>';

        $('#ai-chat-messages').append(html);
        scrollChatToBottom();
    }

    $(document).on('click', '.ai-chat-sql-toggle', function () {
        const $code = $(this).next('.ai-chat-sql-code');
        $code.toggle();
        $(this).text($code.is(':visible') ? 'Hide SQL ▲' : 'Show SQL ▼');
    });

    function formatBotMessage(text) {
        let html = escHtml(text);

        html = html.replace(/^#{1,6}\s+(.+)$/gm, '<strong>$1</strong>');
        html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/(^|[\s(])\*([^*\n]+)\*(?=[\s).,;:!?]|$)/gm, '$1<em>$2</em>');
        html = html.replace(/(^|[\s(])_([^_\n]+)_(?=[\s).,;:!?]|$)/gm, '$1<em>$2</em>');
        html = html.replace(/`(.+?)`/g, '<code>$1</code>');

        html = html.replace(/^\s*[\-\*]\s+(.+)$/gm, '<li>$1</li>');
        html = html.replace(/^\s*\d+\.\s+(.+)$/gm, '<li>$1</li>');
        html = html.replace(/(?:^<li>.*<\/li>$\n?)+/gm, function (list) {
            return '<ul>' + list.replace(/\n/g, '') + '</ul>';
        });

        html = html.replace(/\n\n/g, '</p><p>');
        html = html.replace(/\n/g, '<br>');

        if (!html.startsWith('<')) {
            html = '<p>' + html + '</p>';
        }

        return html;
    }

    function scrollChatToBottom() {
        const $container = $('#ai-chat-messages');
        $container.scrollTop($container[0].scrollHeight);
    }
});
</script>

<?php endif; ?>
