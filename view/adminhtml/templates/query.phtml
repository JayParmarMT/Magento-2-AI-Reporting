            <div class="ai-modal-body">
                <label for="ai-report-title"><?= $block->escapeHtml(__('Report Title')) ?></label>
                <input type="text" id="ai-report-title" class="ai-input"
                       placeholder="<?= $block->escapeHtmlAttr(__('e.g. Monthly Revenue Report')) ?>"/>
            </div>
            <div class="ai-modal-footer">
                <button id="ai-modal-save" class="ai-btn ai-btn-primary"><?= $block->escapeHtml(__('Save')) ?></button>
                <button id="ai-modal-cancel" class="ai-btn ai-btn-secondary"><?= $block->escapeHtml(__('Cancel')) ?></button>
