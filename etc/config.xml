<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <meetanshi_aireporting>
            <general>
                <enabled>1</enabled>
                <llm_provider>groq</llm_provider>
                <openai_model>gpt-4o</openai_model>
                <gemini_model>gemini-1.5-flash</gemini_model>
                <groq_model>llama-3.3-70b-versatile</groq_model>
                <ollama_base_url>http://localhost:11434</ollama_base_url>
                <ollama_model>llama3.2</ollama_model>
                <openrouter_model>meta-llama/llama-3.1-8b-instruct:free</openrouter_model>
                <max_tokens>1024</max_tokens>
                <query_timeout>30</query_timeout>
                <max_rows>500</max_rows>
            </general>
            <security>
                <allowed_roles>Administrators</allowed_roles>
                <log_queries>1</log_queries>
            </security>
        </meetanshi_aireporting>
    </default>
</config>
