<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Meetanshi_AIReporting::aireporting"
                          title="AI Reporting"
                          sortOrder="100">
                    <resource id="Meetanshi_AIReporting::dashboard"
                              title="Dashboard"
                              sortOrder="10"/>
                    <resource id="Meetanshi_AIReporting::query"
                              title="NLP Query"
                              sortOrder="20"/>
                    <resource id="Meetanshi_AIReporting::saved_reports"
                              title="Saved Reports"
                              sortOrder="30"/>
                    <resource id="Meetanshi_AIReporting::reports"
                              title="Pre-built Reports"
                              sortOrder="40">
                        <resource id="Meetanshi_AIReporting::reports_sales"
                                  title="Sales &amp; Revenue"
                                  sortOrder="10"/>
                        <resource id="Meetanshi_AIReporting::reports_customer"
                                  title="Customer Analytics"
                                  sortOrder="20"/>
                        <resource id="Meetanshi_AIReporting::reports_product"
                                  title="Product Performance"
                                  sortOrder="30"/>
                        <resource id="Meetanshi_AIReporting::reports_inventory"
                                  title="Inventory"
                                  sortOrder="40"/>
                    </resource>
                    <resource id="Meetanshi_AIReporting::config"
                              title="Configuration"
                              sortOrder="50"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
